{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdsSync",
  "version": "0.1.0",
  "identifier": "vn.adsync.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AdsSync",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AdsSync",
    "copyright": "AdsSync contributors",
    "category": "Business",
    "shortDescription": "Quản trị quảng cáo đa kênh, self-hosted",
    "longDescription": "AdsSync chạy local: kéo chỉ số Meta/TikTok/Google/OpenAI, Ads Autopilot, Approval Gate cho lệnh ghi và MCP server nội bộ. Dữ liệu nằm trong %APPDATA%\\AdsSync.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/app"],
    "externalBin": ["binaries/node"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"]
      }
    }
  }
}
