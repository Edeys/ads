{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AdsSync",
  "version": "0.2.1",
  "identifier": "vn.adsync.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AdsSync",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "AdsSync",
    "copyright": "AdsSync contributors",
    "category": "Business",
    "shortDescription": "Quản trị quảng cáo đa kênh, self-hosted",
    "longDescription": "AdsSync chạy local: kéo chỉ số Meta/TikTok/Google/OpenAI, Ads Autopilot, Approval Gate cho lệnh ghi và MCP server nội bộ. Dữ liệu nằm trong %APPDATA%\\AdsSync.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": ["resources/app"],
    "externalBin": ["binaries/node"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese", "English"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgwMDFGOTQ1RDJDMTAwRTAKUldUZ0FNSFNSZmtCZ09WMEd6Z1QxbDB1OEI2WHlVOCtKanFZbjBZR3Y3ck9zUzZKblhlSWJlNHcK",
      "endpoints": [
        "https://github.com/Edeys/ads/releases/latest/download/latest.json"
      ]
    }
  }
}
