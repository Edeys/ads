{
  "name": "ads-mcp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit generate && tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "capture": "node scripts/capture/capture.mjs",
    "capture:contracts": "node scripts/capture/contracts.mjs",
    "desktop:icons": "node desktop/make-icons.mjs",
    "desktop:prepare": "node desktop/prepare.mjs",
    "desktop:dev": "powershell -ExecutionPolicy Bypass -File desktop/dev.ps1",
    "desktop:build": "node desktop/prepare.mjs && npm --prefix desktop run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "bullmq": "^5.58.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.4.2",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "pg": "^8.13.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
