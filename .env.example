# --- Tuỳ chọn ---
# Thư mục dữ liệu PGlite (desktop đặt %APPDATA%\AdsSync). Mặc định ./.pgdata
# ADSYNC_DATA_DIR=
# 1 = tự áp migration + seed lõi khi server khởi động (desktop bật)
# ADSYNC_AUTO_MIGRATE=
# 1 = chạy scheduler trong process server (khuyến nghị khi dùng PGlite)
# ADSYNC_INPROC_WORKER=
# 1 = chặn mọi lệnh ghi thật lên tài khoản quảng cáo (mặc định khi chưa set là mock)
# ADSYNC_MOCK=
# 1 = cho phép ghi thật (vẫn phải qua Approval Gate)
# ADSYNC_REAL_WRITES=

# Token cloud Done.vn (nếu dùng MCP của Done.vn) — không commit
DONE_VN_MCP_TOKEN=
